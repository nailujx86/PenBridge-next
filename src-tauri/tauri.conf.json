{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "penbridge-tauri",
  "version": "1.0.0",
  "identifier": "net.nailuj.penbridge-tauri",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "PenBridge",
        "width": 520,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["bridge.exe"],
    "publisher": "Julian Blazek",
    "copyright": "© 2026 Julian Blazek. All rights reserved.",
    "shortDescription": "PenBridge"
  }
}
